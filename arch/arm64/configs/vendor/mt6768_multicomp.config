# Optional configuration fragment for experimental ZRAM multicomp + auto-recompression builds.
# Merge with vendor/mt6768_defconfig; the normal device defconfig stays unchanged.
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_AUTO_RECOMP=y
CONFIG_ZRAM_AUTO_RECOMP_ALGORITHM="zstd"
CONFIG_ZRAM_AUTO_RECOMP_INTERVAL=120
CONFIG_ZRAM_AUTO_RECOMP_PAGES=16384
CONFIG_ZRAM_AUTO_RECOMP_MAX_PAGES=256
# ZRAM writeback is intentionally excluded from this profile.
# CONFIG_ZRAM_WRITEBACK is not set

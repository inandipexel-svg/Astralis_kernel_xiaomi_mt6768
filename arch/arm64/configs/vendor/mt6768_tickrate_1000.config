# Experimental 1000 Hz timer frequency profile for merlin.
# Merge on top of vendor/mt6768_defconfig and vendor/merlin.config.
# Keep tickless idle and high-resolution timers enabled.
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y
CONFIG_NO_HZ_COMMON=y
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_HRTICK=y
